<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>io.github.claude-vps-guard.memwatch</string>

    <key>ProgramArguments</key>
    <array>
        <string>@BIN@/claude-memwatch</string>
    </array>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <!-- The watchdog writes its own log; these catch anything on stderr. -->
    <key>StandardOutPath</key>
    <string>@LOGDIR@/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>@LOGDIR@/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
