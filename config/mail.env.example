# SMTP settings for the bundled notifier (lib/notify-mail.py).
# Copy to ~/.config/claude-vps-guard/mail.env and chmod 600.
# Alerts fall back to log-only while this file is missing or incomplete.

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=alerts@example.com
SMTP_PASS=
MAIL_FROM=alerts@example.com
MAIL_TO=you@example.com

# starttls (default) | ssl | none
SMTP_SECURITY=starttls
