# claude-vps-guard configuration - installed to ~/.config/claude-vps-guard/guard.conf
#
# Sourced by every tool. Values here override the built-in defaults, and
# environment variables override this file. All sizes are megabytes.
#
# The defaults are sized for a small VPS (a few GB of RAM). On a workstation
# with more memory, scale the thresholds up accordingly. As a rule of thumb,
# on a 32G machine: FLOOR_MB=2048, CRIT_MB=1024, PROC_HARD_MB=8192. Leave
# SWAP_FLOOR_MB alone, and set it to 0 on macOS (see the note at the setting).
# The watchdog rereads this file on 'claude-guard restart'.

# --- watchdog thresholds -----------------------------------------------------

# Seconds between checks.
INTERVAL=10

# Pause the largest candidate when available memory drops below this.
FLOOR_MB=900

# Emergency: pause up to the three largest candidates at once.
CRIT_MB=450

# Pause any single process above this, no matter how much memory is free.
PROC_HARD_MB=2800

# When swap exists, treat little free swap as pressure too.
#
# LINUX ONLY. The rule is disabled on macOS, where this value is forced to 0 and
# a value set here is reported as ignored. macOS grows its swap file on demand,
# so free swap never trends toward zero under pressure; it stays inside a narrow
# band. Any floor at or above that band would be permanently true, pausing a
# process on every tick with plenty of RAM free. Measured before the rule was
# disabled: 1024 on a 16G Mac gave 4453 spurious pauses, all logged 'low-mem',
# some with 8G available. On Linux with a fixed swap partition the setting works
# as intended; keep it there.
SWAP_FLOOR_MB=400

# Minimum seconds between notifications. Pauses are always logged.
NOTIFY_COOLDOWN=60

# 1 = log intended actions without pausing or notifying. Useful for tuning.
DRY_RUN=0

# Which processes may be paused, matched against the command name. Anything not
# listed here (sshd, tmux, bash, the watchdog itself) can never be frozen.
CAND_RE='^(claude|node|python|python3|Python|chromium|chrome|headless_shell|playwright)$'

# --- sessions ----------------------------------------------------------------

# Per-session memory cap, enforced by the kernel on Linux. Ignored on macOS.
CLAUDE_MEMORY_MAX=3G

# The Claude Code executable, if it is not simply 'claude' on PATH.
# CLAUDE_BIN=claude

# Where 'ccx <name> -a <account>' keeps per-account Claude Code config
# directories, so several accounts can stay logged in side by side.
# CLAUDE_ACCOUNTS_DIR=$HOME/.claude-accounts

# The machine name shown first in the tmux status bar and in window titles of
# ccx's own tmux server, so a session on another machine (over ssh) is never
# mistaken for a local one. Defaults to 'hostname -s'. The colour is derived
# from the label unless set (any tmux colour: colour33, red, #5f87af).
# CCX_HOST_LABEL=studio
# CCX_HOST_COLOR=colour33

# Scrolling on ccx's own tmux server. 'on' turns the mouse on and binds PgUp/PgDn
# (into copy-mode in a normal pane, passed on to the program in alternate
# screen); 'off' leaves both to your ~/.tmux.conf. CCX_TMUX_HISTORY is the
# scrollback per pane in lines; 0 leaves history-limit alone.
# CCX_TMUX_SCROLL=on
# CCX_TMUX_HISTORY=50000

# --- notifications -----------------------------------------------------------

# Command receiving the subject as its argument and the body on stdin. Leave it
# unset to use the bundled SMTP sender (configured in mail.env).
# Examples:
#   NOTIFY_CMD='/usr/local/bin/terminal-notifier -title'
#   NOTIFY_CMD="$HOME/bin/webhook-alert.sh"
# NOTIFY_CMD=
