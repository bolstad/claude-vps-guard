#!/usr/bin/env bash
# ccx - start or reattach to a named tmux session running Claude Code.
#
# Use 'ccx' instead of 'claude' for sessions that survive a dropped connection
# and that are memory capped where the platform supports it. A 'claude -p' run
# from cron is unaffected.
#
#   ccx                       -> session "claude"
#   ccx <name>                -> session <name>   (several names = several parallel sessions)
#   ccx <name> -a <account>   -> session <name>, logged in as <account>
#   ccx <name> -r             -> session <name>, running 'claude --resume'
#   ccx -c <session-id>       -> new session, auto-named and pointed at the
#                                 right directory and account, continuing
#                                 that one conversation ('ccx resumable'
#                                 lists ids). Already active? Jumps straight
#                                 to its tmux pane instead.
#   ccx up [--windows] [-n]   -> open ALL sessions in one sweep: one tab per session
#                                 in a new Ghostty window (--windows = a window per
#                                 session, CCX_OPEN_MODE=windows to make that the
#                                 default, -n = only show what would be done). If the
#                                 tmux session exists the tab attaches to it; otherwise
#                                 it is recreated with 'claude --resume <id>'. Sessions
#                                 that are already open are skipped.
#   ccx up --from <file>      -> like 'up', but with a frozen list (a save job rewrites
#                                 the default list every minute). <file> can also be a
#                                 date, YYYY-MM-DD, for that day's snapshot.
#   ccx save [file]           -> save the session list (name, account, directory, id)
#                                 to <file>, default ~/.cache/claude-vps-guard/ccx-sessions.tsv.
#                                 A file of your own is never rewritten by a save job, so
#                                 save one before ending sessions on purpose.
#   ccx doctor [directory]    -> can the tmux server read the directory? (macOS access)
#   ccx snapshots             -> list the daily snapshots of the session list (one file a
#                                 day with every session seen that day, kept 30 days)
#   ccx ls                    -> list Claude sessions with memory per session
#   ccx resumable [N|all]     -> Claude Code conversations you can resume,
#                                 across every account, newest first
#   ccx --version             -> the version of this installed copy
#   ccx --help                -> this text
#
# Multiple accounts: -a/--account <name> points Claude Code at its own config
# directory (~/.claude-accounts/<name> by default), so two accounts can stay
# logged in side by side without re-authenticating. The account only needs to
# be given when a session is first created - it lives in that tmux session's
# environment from then on, so a plain 'ccx <name>' reattaches with the same
# account already in place. Set CLAUDE_CONFIG_DIR yourself beforehand to
# override the directory for a single call.
#
# -r/--resume: build the same tmux session, memory cap and account as usual,
# but hand Claude Code '--resume' instead of starting a blank conversation.
# For picking up sessions that were still running when the machine rebooted -
# the tmux sessions are gone, but Claude Code's own history on disk is not.
# Only takes effect when a new session is actually created; reattaching to a
# session that is already running ignores it. 'ccx resumable' finds which
# directory and account to run it from.
#
# -c/--continue <session-id>: the one-step version of the 'resumable' + '-a
# ... -r' combo above. Looks up which directory and account that session id
# belongs to (across every account), builds a new tmux session there with
# 'claude --resume <session-id>' instead of a blank picker, and names it
# after the target directory (deduped against whatever tmux sessions already
# exist). If that session id already has a live process attached somewhere,
# jumps straight to its tmux pane instead of starting a second, duplicate
# conversation. An explicit name ('ccx <name> -c <id>') always reattaches to
# an existing tmux session of that name first, same as -r and -a.
#
# Environment: CLAUDE_MEMORY_MAX (per-session cap, default 3G on Linux),
#              CLAUDE_TMUX_SESSION (default session name),
#              CLAUDE_ACCOUNT (default account), CLAUDE_ACCOUNTS_DIR
#              (default ~/.claude-accounts).
# Own tmux server: ccx uses the socket "ccx" (CCX_TMUX_SOCKET), not the shared
# default server. An orphaned default server can lose macOS access to external
# disks, and every new session then crashes with a misleading "low max file
# descriptors". Old sessions on the default server still show up in 'ccx ls' and
# are attached by 'ccx <name>' and 'ccx up'.
#
# ("ls", "resumable", "up", "open", "save", "doctor", "snapshots" and --help are reserved and
#  cannot be used as session names. A bare 'help' is not reserved, so it still starts a session called
#  "help".)
set -u

# Bumped together with the CHANGELOG on every release, so an installed copy can say
# which version it is ('ccx --version'); 'git describe' only works inside a clone.
CCX_VERSION="1.2.0"

self="${BASH_SOURCE[0]}"
while [ -L "$self" ]; do
    target="$(readlink "$self")"
    case "$target" in
        /*) self="$target" ;;
        *)  self="$(dirname "$self")/$target" ;;
    esac
done
GUARD_BIN_DIR="$(cd "$(dirname "$self")" && pwd)"
# shellcheck source=../lib/common.sh
. "$GUARD_BIN_DIR/../lib/common.sh"

TAB="$(printf '\t')"

# Windows that Ghostty opens through AppleScript, and launchd jobs, get a minimal
# PATH without tmux and claude, so set it explicitly.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:${PATH:-}"

# ccx owns its tmux server (socket "ccx"). A shared default server inherits the
# permission (macOS TCC, e.g. removable volumes) its starting process had, and an
# orphaned server can lose it: every new session then crashes with a misleading
# "low max file descriptors". "default" is the old shared server; it is still
# read so that existing sessions stay visible.
CCX_SOCKET="${CCX_TMUX_SOCKET:-ccx}"
LEGACY_SOCKET="${CCX_LEGACY_SOCKET:-default}"
TMUX_CMD=(tmux -L "$CCX_SOCKET")

# Quote a value for a shell command line (tmux run-shell, the line Ghostty runs).
# Pattern and replacement live in variables because bash 3.2 (stock macOS)
# mangles the backslashes if they are written inline in ${var//.../...}.
sq() { local q="'" r="'\\''"; printf "'%s'" "${1//$q/$r}"; }

# tmx <socket> <tmux-args...>: run tmux against a named server.
tmx() {
    local sock="$1"; shift
    if [ "$sock" = default ]; then tmux "$@"; else tmux -L "$sock" "$@"; fi
}

# Which server has the session? Prints the socket name, otherwise returns 1.
session_socket() {
    local sock
    for sock in "$CCX_SOCKET" "$LEGACY_SOCKET"; do
        if tmx "$sock" has-session -t "=$1" 2>/dev/null; then echo "$sock"; return 0; fi
    done
    return 1
}

# Can the tmux server (and so every session it starts) READ directory $2?
# Measures the server, not this shell. It has to be a read: macOS lets stat
# (ls -d) through even without access, opendir it does not.
# rc 0 = ok, or no server yet (a new server inherits our own access).
server_can_read() {
    local sock="$1" dir="$2" cmd h="#" hh="##"
    tmx "$sock" has-session 2>/dev/null || return 0
    # run-shell expands tmux formats in its argument, so a '#(cmd)' in the path
    # would be run by tmux itself; '##' is tmux's escape for a literal '#'.
    cmd="ls $(sq "$dir") >/dev/null 2>&1"
    tmx "$sock" run-shell "${cmd//$h/$hh}" >/dev/null 2>&1
}

# Error message that replaces Claude Code's misleading fd error. In a terminal we
# wait for Enter so the window does not vanish before the error has been read.
die_wait() {
    printf '%s\n' "$@" >&2
    if [ -t 0 ]; then printf 'Press Enter to close. ' >&2; read -r _ || true; fi
    exit 1
}

ACCOUNT="${CLAUDE_ACCOUNT:-}"
ACCOUNT_EXPLICIT=""
SESSION=""
RESUME=""
EXTRA_ARG=""
EXTRA_ARG2=""
CONTINUE_ID=""
OPEN_MODE="${CCX_OPEN_MODE:-tabs}"
DRY_RUN_UP=""
MANIFEST_FROM=""
NO_WARN="${CCX_NO_WARN:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        -V|--version)
            echo "ccx $CCX_VERSION (claude-vps-guard)"
            exit 0
            ;;
        -h|--help)
            # The header doubles as the help text. The command is renameable
            # via CC_COMMAND_NAME, so print the name it was actually invoked
            # under.
            awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$self" \
                | sed "s/ccx/$(basename "$0")/g"
            exit 0
            ;;
        -a|--account)
            ACCOUNT="${2:-}"
            ACCOUNT_EXPLICIT=1
            shift 2
            ;;
        --account=*)
            ACCOUNT="${1#--account=}"
            ACCOUNT_EXPLICIT=1
            shift
            ;;
        -r|--resume)
            RESUME=1
            shift
            ;;
        -c|--continue)
            CONTINUE_ID="${2:-}"
            shift 2
            ;;
        --continue=*)
            CONTINUE_ID="${1#--continue=}"
            shift
            ;;
        --no-warn)
            NO_WARN=1
            shift
            ;;
        --from)
            MANIFEST_FROM="${2:-}"
            shift 2
            ;;
        -n|--dry-run)
            DRY_RUN_UP=1
            shift
            ;;
        --tabs)
            OPEN_MODE=tabs
            shift
            ;;
        --windows)
            OPEN_MODE=windows
            shift
            ;;
        *)
            if [ -z "$SESSION" ]; then
                SESSION="$1"
            elif [ -z "$EXTRA_ARG" ]; then
                # Only meaningful for 'ccx resumable [N|all]'; a plain session
                # name never reaches this branch since one positional is all
                # 'ccx <name>' takes.
                EXTRA_ARG="$1"
            elif [ -z "$EXTRA_ARG2" ]; then
                EXTRA_ARG2="$1"   # only for 'ccx _attach <socket> <session>'
            fi
            shift
            ;;
    esac
done

# Memory used by one tmux session. On Linux a capped session lives in its own
# systemd scope, whose cgroup accounting is exact; everywhere else the process
# tree below each pane is summed instead.
session_memory_mb() {
    local name="$1" total=0 pane cgroup current seen=""
    while read -r pane; do
        [ -n "$pane" ] || continue
        cgroup=""
        if [ "$GUARD_OS" = linux ] && [ -r "/proc/$pane/cgroup" ]; then
            cgroup="$(sed -n 's/^0:://p' "/proc/$pane/cgroup" 2>/dev/null)"
        fi
        case "$cgroup" in
            */run-*.scope)
                # Panes can share a scope; count each scope once.
                case " $seen " in *" $cgroup "*) continue ;; esac
                seen="$seen $cgroup"
                current="$(cat "/sys/fs/cgroup${cgroup}/memory.current" 2>/dev/null || echo 0)"
                total=$(( total + current ))
                ;;
            *)
                total=$(( total + $(rss_tree_kb "$pane") * 1024 ))
                ;;
        esac
    done < <("${TMUX_CMD[@]}" list-panes -s -t "$name" -F '#{pane_pid}' 2>/dev/null)
    echo $(( total / 1024 / 1024 ))
}

# The account a session was created with, read back from that tmux session's
# own environment (baked in at 'new-session' time, so this works after
# reattaching too). "-" when the session used the default account.
session_account() {
    local line
    line="$("${TMUX_CMD[@]}" show-environment -t "$1" CLAUDE_CONFIG_DIR 2>/dev/null)"
    case "$line" in
        CLAUDE_CONFIG_DIR=*) basename "${line#CLAUDE_CONFIG_DIR=}" ;;
        *) echo "-" ;;
    esac
}

if [ "$SESSION" = "ls" ]; then
    command -v tmux >/dev/null 2>&1 || { echo "tmux is not installed" >&2; exit 1; }
    shown=""
    for sock in "$CCX_SOCKET" "$LEGACY_SOCKET"; do
        tmx "$sock" ls >/dev/null 2>&1 || continue
        [ -z "$shown" ] && printf '%-24s %-9s %-8s %-14s %-9s %s\n' SESSION MEMORY WINDOWS ACCOUNT SERVER CREATED
        shown=1
        TMUX_CMD=(tmux -L "$sock"); [ "$sock" = default ] && TMUX_CMD=(tmux)
        tmux_list="$("${TMUX_CMD[@]}" list-sessions -F '#{session_name}|#{session_windows}|#{t:session_created}' 2>/dev/null)"
        while IFS='|' read -r name windows created; do
            [ -n "$name" ] || continue
            printf '%-24s %-9s %-8s %-14s %-9s %s\n' "$name" "$(session_memory_mb "$name") MB" "$windows" "$(session_account "$name")" "$sock" "$created"
        done <<<"$tmux_list"
    done
    [ -n "$shown" ] || echo "(no tmux sessions)"
    exit 0
fi

# The first line of a Claude Code conversation that actually holds a working
# directory. Read straight from the session's own record instead of decoding
# it back out of the project directory name: '~/.claude/projects' encodes a
# path by turning every '/' into '-', which is ambiguous the moment a real
# directory name contains a dash too (e.g. 'claude-vps-guard').
session_cwd() {
    grep -m1 -o '"cwd":"[^"]*"' "$1" | sed 's/^"cwd":"//; s/"$//'
}

# File mtime as epoch seconds, then as a human timestamp. 'stat' and 'date'
# take incompatible flags on BSD (macOS) vs GNU (Linux); each pair below tries
# the BSD form first and falls through to the GNU form on failure rather than
# branching on GUARD_OS, since that is the only difference between them.
file_mtime_epoch() { stat -f '%m' "$1" 2>/dev/null || stat -c '%Y' "$1" 2>/dev/null; }
epoch_to_human() { date -r "$1" '+%Y-%m-%d %H:%M' 2>/dev/null || date -d "@$1" '+%Y-%m-%d %H:%M' 2>/dev/null; }

# Every '<id>.jsonl' under a Claude Code projects dir, one 'epoch<TAB>account
# <TAB>id<TAB>cwd' line per session. $1 = projects dir, $2 = account label.
list_resumable() {
    local pdir="$1" account="$2" f cwd
    for f in "$pdir"/*/*.jsonl; do
        [ -e "$f" ] || continue
        cwd="$(session_cwd "$f")"
        [ -n "$cwd" ] || continue
        printf '%s\t%s\t%s\t%s\n' "$(file_mtime_epoch "$f")" "$account" "$(basename "$f" .jsonl)" "$cwd"
    done
}

# Same rows as 'list_resumable', gathered across the default account and
# every '-a' account under CLAUDE_ACCOUNTS_DIR.
all_resumable_sessions() {
    list_resumable "$HOME/.claude/projects" "-"
    local acct_dir
    for acct_dir in "$CLAUDE_ACCOUNTS_DIR"/*/; do
        [ -d "$acct_dir/projects" ] || continue
        list_resumable "$acct_dir/projects" "$(basename "$acct_dir")"
    done
}

# A top-level string field out of a small single-line JSON object. Not a
# general JSON parser - fine for the flat records Claude Code writes into
# 'sessions/<pid>.json', which is the only shape these two ever see.
json_str() { grep -o "\"$2\":\"[^\"]*\"" "$1" 2>/dev/null | head -1 | sed "s/^\"$2\":\"//; s/\"\$//"; }
json_num() { grep -o "\"$2\":[0-9]*" "$1" 2>/dev/null | head -1 | cut -d: -f2; }

# 'sessionId<TAB>name<TAB>status<TAB>pid<TAB>tmux', one line per session that
# currently has a live CLI process attached, under a Claude Code config dir
# ($1 = '~/.claude' or an account's directory). Claude Code writes a lock
# file to 'sessions/<pid>.json' for the life of the process (status 'busy' or
# 'idle', a name it derives for that run, and - when launched inside tmux -
# the exact pane it is running in) but only cleans it up on its *next*
# launch, not on exit - a crashed or kill -9'd process leaves its file behind
# looking identical to a live one. The 'kill -0' check is what actually tells
# 'active' from 'resumable'; the lock file alone does not.
live_claude_sessions() {
    local base="$1" f pid sid name status tmux_target
    for f in "$base"/sessions/*.json; do
        [ -e "$f" ] || continue
        pid="$(json_num "$f" pid)"
        [ -n "$pid" ] && pid_alive "$pid" || continue
        sid="$(json_str "$f" sessionId)"
        [ -n "$sid" ] || continue
        name="$(json_str "$f" name)"
        status="$(json_str "$f" status)"
        tmux_target="$(json_str "$f" tmux)"
        printf '%s\t%s\t%s\t%s\t%s\n' "$sid" "${name:--}" "${status:--}" "$pid" "$tmux_target"
    done
}

# Same rows as 'live_claude_sessions', gathered across the default account
# and every '-a' account under CLAUDE_ACCOUNTS_DIR.
all_live_claude_sessions() {
    live_claude_sessions "$HOME/.claude"
    local acct_dir
    for acct_dir in "$CLAUDE_ACCOUNTS_DIR"/*/; do
        [ -d "$acct_dir" ] || continue
        live_claude_sessions "${acct_dir%/}"
    done
}

if [ "$SESSION" = "resumable" ]; then
    LIMIT="${EXTRA_ARG:-30}"
    LIVE_SESSIONS="$(all_live_claude_sessions)"

    printf '%-17s %-12s %-14s %-20s %-38s %s\n' TIME ACCOUNT STATUS NAME SESSION PATH
    all_resumable_sessions \
      | sort -t "$TAB" -k1,1rn \
      | { [ "$LIMIT" = all ] && cat || head -n "$LIMIT"; } \
      | while IFS="$TAB" read -r mtime account id cwd; do
            hit="$(grep -m1 "^$id$TAB" <<<"$LIVE_SESSIONS")"
            if [ -n "$hit" ]; then
                name="$(cut -d "$TAB" -f2 <<<"$hit")"
                status="active ($(cut -d "$TAB" -f3 <<<"$hit"))"
            else
                name="-"
                status="resumable"
            fi
            printf '%-17s %-12s %-14s %-20s %-38s %s\n' "$(epoch_to_human "$mtime")" "$account" "$status" "$name" "$id" "$cwd"
        done
    echo
    echo "'active (busy|idle)' already has a live process - reattach via 'ccx ls' / tmux, do not resume it again."
    echo "'resumable' is only on disk - pick it up with: cd <path> && ccx <name> -a <account> -r   ('-a' only for a non-'-' account)"
    echo "Either way, 'ccx -c <session-id>' does it in one step."
    exit 0
fi

command -v tmux >/dev/null 2>&1 || { echo "tmux is not installed" >&2; exit 1; }

# --- recovery: save the session list, open everything in one sweep ----------------
#
# The tmux sessions survive Ghostty dying; what is missing is attaching to them
# again. 'ccx save' writes a list (name, account, directory, Claude session id)
# and 'ccx up' opens a Ghostty tab or window per session: if the tmux session
# exists the window attaches, otherwise it is recreated with 'claude --resume
# <id>'. Every window runs 'ccx <name> -c <id>' itself, so a new tmux server is
# born INSIDE Ghostty and inherits its access to external disks.

MANIFEST="$GUARD_STATE_DIR/ccx-sessions.tsv"
DEFAULT_MANIFEST="$MANIFEST"          # only the default list gets snapshots
SNAPSHOT_DIR="$GUARD_STATE_DIR/snapshots"
SNAPSHOT_KEEP_DAYS="${CCX_SNAPSHOT_KEEP_DAYS:-30}"

# Epoch seconds of the last boot, empty if unknown.
boot_epoch() {
    if [ "$GUARD_OS" = macos ]; then
        sysctl -n kern.boottime 2>/dev/null | sed -n 's/.*{ sec = \([0-9]*\),.*/\1/p'
    elif [ "$GUARD_OS" = linux ]; then
        awk '/^btime/ { print $2; exit }' /proc/stat 2>/dev/null
    fi
}

# True when the list was last written before the current boot, i.e. it is the
# list from before a restart or crash.
list_predates_boot() {
    local m boot
    [ -s "$1" ] || return 1
    m="$(file_mtime_epoch "$1")"; boot="$(boot_epoch)"
    [ -n "$m" ] && [ -n "$boot" ] && [ "$m" -lt "$boot" ]
}

# Keep the list from before a restart before anything replaces it: the first
# session started after a reboot makes the next save rewrite the list with just
# that one session.
save_preboot_copy() {
    local m dest
    list_predates_boot "$MANIFEST" || return 0
    m="$(file_mtime_epoch "$MANIFEST")"
    mkdir -p "$SNAPSHOT_DIR"
    dest="$SNAPSHOT_DIR/ccx-sessions.before-restart-$(date -r "$m" '+%Y-%m-%d_%H%M' 2>/dev/null || date -d "@$m" '+%Y-%m-%d_%H%M').tsv"
    [ -e "$dest" ] || cp "$MANIFEST" "$dest"
}

# One file per day holding every session seen that day (the newest row wins per
# name), so a session ended on purpose in the afternoon is still in the morning's
# picture. Old snapshots are pruned.
update_daily_snapshot() {
    local today snap tmp
    today="${CCX_SNAPSHOT_DATE:-$(date +%F)}"
    snap="$SNAPSHOT_DIR/ccx-sessions.$today.tsv"
    mkdir -p "$SNAPSHOT_DIR"
    tmp="$snap.tmp.$$"
    { printf '%s' "$1"; [ -f "$snap" ] && cat "$snap"; } | awk -F'\t' '!seen[$1]++' > "$tmp" && mv "$tmp" "$snap"
    find "$SNAPSHOT_DIR" -name 'ccx-sessions.*.tsv' -mtime +"$SNAPSHOT_KEEP_DAYS" -delete 2>/dev/null || true
}

# Before a session is started from scratch: if this computer restarted after the
# list was saved and nothing is running, say so and let the user back out.
warn_unrestored_sessions() {
    local sock m n
    [ "${CCX_WARN:-boot}" = never ] && return 0
    for sock in "$CCX_SOCKET" "$LEGACY_SOCKET"; do
        tmx "$sock" has-session 2>/dev/null && return 0
    done
    list_predates_boot "$MANIFEST" || return 0
    m="$(file_mtime_epoch "$MANIFEST")"
    n="$(grep -c . "$MANIFEST")"
    {
        echo
        echo "ccx: this computer restarted after the session list was saved ($(epoch_to_human "$m")),"
        echo "     and $n saved session(s) are not running:"
        cut -f1,2,3 "$MANIFEST" | head -12 | awk -F'\t' '{ printf "       %-22s %-9s %s\n", $1, $2, $3 }'
        [ "$n" -gt 12 ] && echo "       ... and $((n - 12)) more"
        echo "     Starting a new session now replaces that list within a minute."
        echo "     A copy is kept in $SNAPSHOT_DIR."
    } >&2
    if [ ! -t 0 ] || [ ! -t 2 ]; then
        save_preboot_copy
        echo "     (not interactive, continuing; restore later with: ccx up --from <file from ccx snapshots>)" >&2
        return 0
    fi
    printf '     [u] run ccx up and restore them   [c] continue with this session   [q] quit (default q): ' >&2
    local ans=""
    read -r ans || true
    case "$ans" in
        u|U) exec "$CCX_SELF" up ;;
        c|C) save_preboot_copy; return 0 ;;
        *)   echo "ccx: nothing started." >&2; exit 1 ;;
    esac
}

cmd_snapshots() {
    local f
    [ -d "$SNAPSHOT_DIR" ] || { echo "no snapshots yet in $SNAPSHOT_DIR"; return 0; }
    printf '%-46s %s\n' FILE SESSIONS
    for f in $(ls -1t "$SNAPSHOT_DIR"/ccx-sessions.*.tsv 2>/dev/null); do
        printf '%-46s %s  (%s)\n' "$(basename "$f")" "$(grep -c . "$f")" "$(cut -f1 "$f" | tr '\n' ' ' | cut -c1-70)"
    done
    echo
    echo "Restore one with: ccx up --from <file>   (or --from YYYY-MM-DD for a daily snapshot)"
}
# Absolute, because the windows Ghostty opens start in another directory.
CCX_SELF="$GUARD_BIN_DIR/$(basename "$self")"

cmd_save() {
    mkdir -p "$GUARD_STATE_DIR"
    local live sock names name acct cwd sid seen="" rows="" tmp
    live="$(all_live_claude_sessions)"
    for sock in "$CCX_SOCKET" "$LEGACY_SOCKET"; do
        names="$(tmx "$sock" list-sessions -F '#{session_name}' 2>/dev/null)" || continue
        TMUX_CMD=(tmux -L "$sock"); [ "$sock" = default ] && TMUX_CMD=(tmux)
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            case "$seen" in *"|$name|"*) continue ;; esac
            seen="$seen|$name|"
            acct="$(session_account "$name")"
            cwd="$(tmx "$sock" display-message -p -t "=$name:" '#{pane_current_path}' 2>/dev/null)"
            sid="$(awk -F'\t' -v n="$name" 'index($5, n ":") == 1 { print $1; exit }' <<<"$live")"
            rows="${rows}${name}${TAB}${acct}${TAB}${cwd}${TAB}${sid:--}${TAB}$(date +%s)"$'\n'
        done <<<"$names"
    done
    # No tmux server at all (crashed, rebooted): keep the last list, it is exactly
    # what is needed to recreate the sessions. While a server lives the whole
    # list is rewritten, so a session ended with /exit drops out at the next save.
    if [ -z "$rows" ]; then
        [ -n "${CCX_VERBOSE:-}" ] && echo "no sessions running, keeping $MANIFEST" >&2
        return 0
    fi
    if [ "$MANIFEST" = "$DEFAULT_MANIFEST" ]; then
        save_preboot_copy
        update_daily_snapshot "$rows"
    fi
    tmp="$MANIFEST.tmp.$$"
    printf '%s' "$rows" > "$tmp"
    # .prev holds the list before the last real change; the timestamp column
    # differs on every save and must not count as one.
    if [ -f "$MANIFEST" ] && ! cmp -s <(cut -f1-4 "$tmp") <(cut -f1-4 "$MANIFEST"); then
        cp "$MANIFEST" "$MANIFEST.prev"
    fi
    mv "$tmp" "$MANIFEST"
    [ -n "${CCX_VERBOSE:-}" ] && echo "saved $(printf '%s' "$rows" | grep -c .) sessions to $MANIFEST" >&2
    return 0
}

ghostty_script() { osascript - "$@" 2>/dev/null; }

ghostty_wait_ready() {
    local i
    for i in $(seq 1 40); do
        [ "$(osascript -e 'tell application "Ghostty" to count windows' 2>/dev/null || echo 0)" -ge 1 ] 2>/dev/null && return 0
        sleep 0.5
    done
    return 1
}

# Open the window with your normal shell and send "exec <command>" as initial
# input. A 'command' in the surface configuration leaves a ghost window behind
# once the process ends; with exec the shell is replaced and the window closes
# as usual. Prints the id of the new window.
ghostty_open() { # $1 = command, $2 = directory, $3 = tabs|windows, $4 = window id for tabs
    if [ "$3" = tabs ] && [ -n "${4:-}" ]; then
        ghostty_script "$1" "$2" "$4" <<'AS'
on run argv
    tell application "Ghostty"
        set cfg to new surface configuration
        set initial input of cfg to ("exec " & (item 1 of argv) & linefeed)
        set initial working directory of cfg to item 2 of argv
        new tab in window id (item 3 of argv) with configuration cfg
        return item 3 of argv
    end tell
end run
AS
    else
        ghostty_script "$1" "$2" <<'AS'
on run argv
    tell application "Ghostty"
        set cfg to new surface configuration
        set initial input of cfg to ("exec " & (item 1 of argv) & linefeed)
        set initial working directory of cfg to item 2 of argv
        set w to new window with configuration cfg
        return id of w
    end tell
end run
AS
    fi
}

cmd_up() {
    local name acct cwd sid saved sock att cmd win="" initial="" opened=0 skipped=0 failed=0 started=""
    # --from <file>: use a frozen list instead of the one the save job rewrites
    # every minute (for example after you ended sessions with /exit).
    if [ -n "$MANIFEST_FROM" ]; then
        # --from 2026-10-16 means that day's snapshot
        [ -e "$MANIFEST_FROM" ] || [ ! -e "$SNAPSHOT_DIR/ccx-sessions.$MANIFEST_FROM.tsv" ] \
            || MANIFEST_FROM="$SNAPSHOT_DIR/ccx-sessions.$MANIFEST_FROM.tsv"
        [ -s "$MANIFEST_FROM" ] || { echo "The list $MANIFEST_FROM is missing or empty." >&2; exit 1; }
        MANIFEST="$MANIFEST_FROM"
    else
        cmd_save
    fi
    [ -s "$MANIFEST" ] || { echo "No session list to open ($MANIFEST is missing or empty)." >&2; exit 1; }

    if [ -z "$DRY_RUN_UP" ] && ! pgrep -xq ghostty; then
        open -a Ghostty || { echo "Could not start Ghostty." >&2; exit 1; }
        started=1
    fi
    [ -n "$DRY_RUN_UP" ] || ghostty_wait_ready || { echo "Ghostty does not answer AppleScript (Automation permission?)." >&2; exit 1; }
    # If we started Ghostty it opens an empty default window; we close that last.
    [ -n "$started" ] && [ -z "$DRY_RUN_UP" ] && initial="$(osascript -e 'tell application "Ghostty" to id of front window' 2>/dev/null)"

    while IFS="$TAB" read -r name acct cwd sid saved; do
        [ -n "$name" ] || continue
        if sock="$(session_socket "$name")"; then
            att="$(tmx "$sock" display-message -p -t "=$name:" '#{session_attached}' 2>/dev/null || echo 0)"
            if [ "${att:-0}" -gt 0 ] 2>/dev/null; then
                echo "  =  $name  (already open)"; skipped=$((skipped + 1)); continue
            fi
            cmd="$(sq "$CCX_SELF") _attach $(sq "$sock") $(sq "$name")"
            echo "  ↻  $name  (attaching)"
        else
            if ! ls "$cwd" >/dev/null 2>&1; then
                echo "  !  $name  directory not reachable: $cwd" >&2; failed=$((failed + 1)); continue
            fi
            cmd="$(sq "$CCX_SELF") --no-warn $(sq "$name")"
            [ "$acct" != "-" ] && cmd="$cmd -a $(sq "$acct")"
            [ "$sid" != "-" ] && cmd="$cmd -c $(sq "$sid")"
            if [ "$sid" != "-" ]; then echo "  +  $name  (recreating, id ${sid:0:8}…)"; else echo "  +  $name  (recreating without id, new conversation)"; fi
        fi
        if [ -n "$DRY_RUN_UP" ]; then
            echo "       [dry-run] $cmd   (cwd $cwd)"; opened=$((opened + 1)); continue
        fi
        if out="$(ghostty_open "$cmd" "$cwd" "$OPEN_MODE" "$win")" && [ -n "$out" ]; then
            [ "$OPEN_MODE" = tabs ] && win="$out"
            opened=$((opened + 1))
        else
            echo "  !  $name  Ghostty could not open the window" >&2; failed=$((failed + 1))
        fi
        sleep 1.5   # stagger the startups, a dozen Claude processes at once is needlessly heavy
    done < "$MANIFEST"

    if [ -n "$initial" ] && [ "$opened" -gt 0 ]; then
        osascript -e "tell application \"Ghostty\" to close window (window id \"$initial\")" >/dev/null 2>&1 || true
    fi
    echo "done: $opened opened, $skipped already open, $failed failed"
    [ "$failed" -eq 0 ]
}

cmd_doctor() {
    local dir="${1:-$PWD}" sock rc=0
    echo "directory: $dir"
    for sock in "$CCX_SOCKET" "$LEGACY_SOCKET"; do
        if ! tmx "$sock" has-session 2>/dev/null; then echo "  server '$sock': no server running"; continue; fi
        if server_can_read "$sock" "$dir"; then
            echo "  server '$sock': OK, can read the directory"
        else
            echo "  server '$sock': NO ACCESS (new sessions here crash with 'low max file descriptors')"
            rc=1
        fi
    done
    [ "$rc" -eq 0 ] || echo "Fix: save the list ('ccx save'), end the sessions with /exit, then run 'ccx up' from Ghostty."
    return "$rc"
}

case "$SESSION" in
    save)   [ -n "$EXTRA_ARG" ] && MANIFEST="$EXTRA_ARG"   # 'ccx save <file>': a list of your own
            [ -t 2 ] && CCX_VERBOSE=1; cmd_save; exit $? ;;
    up|open) cmd_up; exit $? ;;
    doctor) cmd_doctor "${EXTRA_ARG:-$PWD}"; exit $? ;;
    snapshots) cmd_snapshots; exit $? ;;
    _attach)
        # intern: ccx _attach <socket> <session>
        if [ "$EXTRA_ARG" = default ]; then exec tmux attach -t "=$EXTRA_ARG2"; fi
        exec tmux -L "$EXTRA_ARG" attach -t "=$EXTRA_ARG2"
        ;;
esac

# 'ccx -c <session-id>': resolve which directory and account that id belongs
# to, or - if it is already running somewhere - jump straight to its tmux
# pane instead of starting a duplicate conversation.
FOUND_CWD=""
if [ -n "$CONTINUE_ID" ]; then
    live="$(all_live_claude_sessions | grep -m1 "^$CONTINUE_ID$TAB")"
    if [ -n "$live" ]; then
        pid="$(cut -d "$TAB" -f4 <<<"$live")"
        tmux_target="$(cut -d "$TAB" -f5 <<<"$live")"
        if [ -n "$tmux_target" ] && "${TMUX_CMD[@]}" has-session -t "$tmux_target" 2>/dev/null; then
            exec "${TMUX_CMD[@]}" attach -t "$tmux_target"
        fi
        echo "session $CONTINUE_ID is already active (pid $pid) but not reachable through tmux." >&2
        echo "find its terminal directly, e.g.: ps -p $pid -o pid,etime,command" >&2
        exit 1
    fi

    found="$(all_resumable_sessions | grep -m1 "$TAB$CONTINUE_ID$TAB")"
    if [ -z "$found" ]; then
        echo "no Claude Code session found with id $CONTINUE_ID" >&2
        echo "'ccx resumable all' lists every id ccx knows about" >&2
        exit 1
    fi
    FOUND_ACCOUNT="$(cut -d "$TAB" -f2 <<<"$found")"
    FOUND_CWD="$(cut -d "$TAB" -f4 <<<"$found")"
    if [ -z "$ACCOUNT_EXPLICIT" ] && [ "$FOUND_ACCOUNT" != "-" ]; then
        ACCOUNT="$FOUND_ACCOUNT"
    fi

    if [ -z "$SESSION" ]; then
        # Name the new session after the target directory, so several '-c'
        # calls in a row do not all pile into the same "claude" session.
        # Substitution, not 'basename | tr': piping into tr carries
        # basename's trailing newline along, which is outside the allowed
        # set and turns into a spurious trailing '-' on every name.
        base_name="$(basename "$FOUND_CWD")"
        base_name="${base_name//[^A-Za-z0-9_-]/-}"
        [ -n "$base_name" ] || base_name="claude"
        SESSION="$base_name"
        n=2
        while "${TMUX_CMD[@]}" has-session -t "$SESSION" 2>/dev/null; do
            SESSION="${base_name}-${n}"
            n=$(( n + 1 ))
        done
    fi
fi

SESSION="${SESSION:-${CLAUDE_TMUX_SESSION:-claude}}"

if [ -n "$ACCOUNT" ]; then
    # CLAUDE_ACCOUNTS_DIR comes from common.sh (config file / env / default).
    : "${CLAUDE_CONFIG_DIR:=$CLAUDE_ACCOUNTS_DIR/$ACCOUNT}"
    export CLAUDE_CONFIG_DIR
    mkdir -p "$CLAUDE_CONFIG_DIR"
fi

if existing_sock="$(session_socket "$SESSION")"; then
    if [ "$existing_sock" = default ]; then exec tmux attach -t "=$SESSION"; fi
    exec tmux -L "$existing_sock" attach -t "=$SESSION"
fi

# A restart leaves a saved list of sessions that are no longer running. Starting
# a session first would replace that list, so ask before going ahead.
[ -n "$NO_WARN" ] || warn_unrestored_sessions

# Before creating anything: can the server read the directory? If not, Claude
# Code crashes at once with a misleading "low max file descriptors" error
# (really EPERM from macOS). Say so plainly instead.
_probe_dir="${FOUND_CWD:-$PWD}"
if ! server_can_read "$CCX_SOCKET" "$_probe_dir"; then
    die_wait "ccx: the tmux server '$CCX_SOCKET' cannot access $_probe_dir" \
             "(macOS 'Operation not permitted', typically on an external disk)." \
             "Claude Code would crash here with a misleading 'low max file descriptors'." \
             "Fix: ccx save, end the sessions with /exit, then run ccx up from Ghostty." \
             "Diagnose: ccx doctor"
fi

# A new session does not inherit this shell's environment: it starts from the
# tmux *server's*, refreshed only for the variables in 'update-environment'.
# CLAUDE_CONFIG_DIR is not one of those, so passing it implicitly only worked
# when this very call also started the server - on a host that already had a
# tmux session running, -a was silently ignored. Hand it to the command
# explicitly, and record it in the session's own environment so 'ccx ls' can
# read the account back and later windows in the session start on it too.
RESUME_ARG=""
[ -n "$RESUME" ] && RESUME_ARG=" --resume"
[ -n "$CONTINUE_ID" ] && RESUME_ARG=" --resume '$CONTINUE_ID'"

# '-c' resolved a directory the target conversation actually ran in; hand it
# to 'tmux new-session -c' so the pane starts there regardless of where this
# command itself was invoked from.
NEW_SESSION_ARGS=(-d -s "$SESSION")
[ -n "$FOUND_CWD" ] && NEW_SESSION_ARGS+=(-c "$FOUND_CWD")

if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
    "${TMUX_CMD[@]}" new-session "${NEW_SESSION_ARGS[@]}" \
        "exec env CLAUDE_CONFIG_DIR='$CLAUDE_CONFIG_DIR' '$GUARD_BIN_DIR/claude-guarded'$RESUME_ARG" || exit 1
    "${TMUX_CMD[@]}" set-environment -t "$SESSION" CLAUDE_CONFIG_DIR "$CLAUDE_CONFIG_DIR"
else
    "${TMUX_CMD[@]}" new-session "${NEW_SESSION_ARGS[@]}" \
        "exec '$GUARD_BIN_DIR/claude-guarded'$RESUME_ARG" || exit 1
fi
# The session name as window title, so Ghostty windows and tabs can be told apart.
"${TMUX_CMD[@]}" set-option -g set-titles on 2>/dev/null
"${TMUX_CMD[@]}" set-option -g set-titles-string '#S' 2>/dev/null
exec "${TMUX_CMD[@]}" attach -t "=$SESSION"
